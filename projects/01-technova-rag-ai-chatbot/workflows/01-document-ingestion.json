      "typeVersion": 1,
      "position": [
        896,
        416
      ],
      "name": "07 - Split Document Content"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "name": "01 - Manual Trigger"
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
