      "typeVersion": 3,
      "position": [
        224,
        0
      ],
      "name": "02 - Search Company Documents"
    },
    {
      "parameters": {
        "dataType": "binary",
        "loader": "pdfLoader",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "file_name",
                "value": "={{ $binary.data.fileName }}"
              },
              {
                "name": "source",
                "value": "Google Drive"
              },
              {
                "name": "company",
                "value": "TechNova Solutions"
              },
              {
                "name": "file_id",
                "value": "={{ $('02 - Search Company Documents').item.json.id }}"
              }
            ]
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        880,
        192
      ],
      "name": "06 - Load PDF Content"
    },
    {
      "parameters": {
        "chunkOverlap": 150,
        "options": {}
      },
